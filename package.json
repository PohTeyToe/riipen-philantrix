{
  "name": "philantrix-funder-report",
  "version": "0.1.0",
  "private": true,
  "description": "Quarter-end funder report: a working slice built for Philantrix's Riipen Platform Expansion project. Sample data only.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5102",
    "check:narrative": "node scripts/check-narrative.mjs",
    "agent:build": "vite build --ssr agent/engine.ts --outDir agent/.build --emptyOutDir --logLevel warn",
    "agent:run": "npm run agent:build && node agent/run.mjs",
    "prebuild": "node scripts/check-narrative.mjs",
    "build": "next build",
    "preview": "node scripts/serve-out.mjs 5102",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
